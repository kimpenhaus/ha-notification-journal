{
  "options": {
    "step": {
      "init": {
        "sections": {
          "sources": "mdi:tray-arrow-down",
          "retention": "mdi:clock-outline",
          "access": "mdi:account-outline",
          "sidebar": "mdi:dock-left"
        }
      }
    }
  },
  "entity": {
    "sensor": {
      "notifications_today": {
        "default": "mdi:bell-outline"
      },
      "failed_today": {
        "default": "mdi:bell-alert-outline"
      }
    }
  },
  "services": {
    "query": {
      "service": "mdi:text-box-search-outline"
    }
  }
}
